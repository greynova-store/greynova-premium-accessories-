# Greynova Store & Supabase Configuration
# Client-accessible variables (prefixed with VITE_)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
VITE_STORE_CURRENCY="PKR"
VITE_STORE_CURRENCY_SYMBOL="Rs."

# Server-Side Only Credentials (NEVER expose to frontend bundle)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_SECRET_KEY="your-service-role-secret-key"

# Payment Provider Configuration (Abstraction Layer)
# Supported options: stripe, jazzcash, easypaisa, manual_cod
PAYMENT_PROVIDER="manual_cod"
PAYMENT_PROVIDER_SECRET_KEY="sk_test_..."
PAYMENT_WEBHOOK_SECRET="whsec_..."

# Administrator Bootstrap Token (Used during initial owner setup)
ADMIN_BOOTSTRAP_TOKEN="greynova-tanoli-init-2026"

# Environment & Server
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
